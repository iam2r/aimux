{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local"
    }
  },
  "theme": "dark",
  "model": "anthropic/claude-sonnet-4",
  "provider": {
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "sk-ant-keep"
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai"
    },
    "old-relay": {
      "npm": "old-package",
      "name": "Old",
      "options": {
        "baseURL": "https://old.example.com",
        "apiKey": "old-key"
      },
      "models": {
        "old-model": {
          "name": "old-model"
        }
      }
    }
  },
  "unknownTop": {
    "keep": true
  }
}
