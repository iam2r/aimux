# pre-commit: format staged Rust files via lint-staged and re-stage them.
# Without node (Rust-only contributors), fall back to a
# non-mutating workspace-wide rustfmt check so formatting is still enforced.
if command -v npx >/dev/null 2>&1; then
	npx lint-staged --allow-empty
else
	echo "pre-commit: npx not found — running plain 'cargo fmt' check instead."
	if ! cargo fmt --all -- --check; then
		echo "pre-commit: formatting failed — run 'cargo fmt --all' and re-stage."
		exit 1
	fi
fi
